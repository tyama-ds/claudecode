# Copy to `.env` (loaded automatically). All values are optional.

# --- Server ---
# ORCHESTRATOR_HOST=127.0.0.1
# ORCHESTRATOR_PORT=8765
# ORCHESTRATOR_MAX_TOKENS=4096
# ORCHESTRATOR_CLI_TIMEOUT=600

# --- Network (proxy applies to all API calls; can also be set in the UI) ---
# HTTPS_PROXY=http://proxy.corp:8080

# Anything below can also be entered in the UI "Settings" tab (used when the
# env var isn't set). Base URLs let you target any OpenAI-compatible provider.

# --- Claude (API) adapter (no install — stdlib HTTP) ---
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-4-8
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- GPT (API) adapter (no install — stdlib HTTP) ---
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Local LLM adapter (OpenAI-compatible, e.g. Ollama / LM Studio) ---
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# LOCAL_LLM_MODEL=llama3.1
# LOCAL_LLM_API_KEY=local
