# Copy to `.env` (loaded automatically). All values are optional.

# --- Server ---
# ORCHESTRATOR_HOST=127.0.0.1
# ORCHESTRATOR_PORT=8765
# ORCHESTRATOR_MAX_TOKENS=4096
# ORCHESTRATOR_CLI_TIMEOUT=600

# --- Claude (API) adapter (no install — stdlib HTTP) ---
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-4-8

# --- GPT (API) adapter (no install — stdlib HTTP) ---
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# --- Local LLM adapter (OpenAI-compatible, e.g. Ollama / LM Studio) ---
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# LOCAL_LLM_MODEL=llama3.1
